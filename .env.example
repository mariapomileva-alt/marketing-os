# ---------- Database ----------
# Local: Postgres 16+ with pgvector. Supabase: the project's direct connection string.
DATABASE_URL=postgresql://postgres@localhost:54329/marketing_os
# Separate database used by integration tests (wiped and migrated on every run).
TEST_DATABASE_URL=postgresql://postgres@localhost:54329/marketing_os_test

# ---------- Authentication ----------
# "supabase" in any deployed environment. "dev" = single local owner without email login;
# refused when NODE_ENV=production.
AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Signs the dev-mode session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=

# ---------- Secrets encryption ----------
# 32-byte base64 key for AES-256-GCM encryption of API keys and tokens at rest.
# Generate: openssl rand -base64 32. Never commit the real value.
ENCRYPTION_KEY_V1=
ENCRYPTION_ACTIVE_KEY_VERSION=1

# ---------- AI ----------
# "mock" (default, no external calls) | "anthropic" | "openai". Real keys are entered in
# Connections and stored encrypted in the database, not here.
AI_DEFAULT_PROVIDER=mock
AI_RUN_BUDGET_USD=0.50
AI_DAILY_BUDGET_USD=5

# ---------- Files ----------
# "local" (stores under STORAGE_LOCAL_DIR) | "supabase"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# Supabase Storage (STORAGE_DRIVER=supabase): private bucket name and the service-role key (server only).
SUPABASE_STORAGE_BUCKET=knowledge
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Access ----------
# Who may use a hosted deployment (comma-separated). Listed addresses get an account on their first sign-in link.
ALLOWED_EMAILS=
# First password for an address in ALLOWED_EMAILS (12+ characters). Signing in with it sets it as the Supabase password.
OWNER_PASSWORD=

# ---------- YouTube community (drafts only) ----------
# Read-only YouTube Data API v3 key (Google Cloud → APIs & Services → Credentials). Used to find videos.
YOUTUBE_API_KEY=
# Posting comments stays off until the owner switches it on after the dry run. Even then every comment needs approval.
YOUTUBE_PUBLISHING_ENABLED=false
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/youtube once a day.
CRON_SECRET=

# ---------- Telegram notifications (optional) ----------
# A bot from @BotFather and your chat id. Notifications only: approval always happens in Marketing OS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public address used in notification links (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically).
APP_URL=

# ---------- Monitoring (optional) ----------
SENTRY_DSN=

# Posting to YouTube as the channel (Google OAuth, Web application client)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Threads (Meta app with the Threads use case)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_PUBLISHING_ENABLED=
